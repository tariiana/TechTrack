# Пример production-настроек backend. Скопируйте в .env и замените значения.
NODE_ENV=production
PORT=3000

# Подключение к PostgreSQL.
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# JWT_SECRET должен быть длинной случайной строкой, одинаковой для всех
# инстансов backend. BCRYPT_ROUNDS влияет на стоимость хеширования пароля.
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Домен фронтенда, которому разрешены браузерные запросы к API.
CORS_ORIGIN=https://your-domain.example
